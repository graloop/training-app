# Copy this file to .env and fill in real values before running
# `docker compose up` or deploying as a Portainer stack.

POSTGRES_USER=trainer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trainer

# Random secret used to sign JWT session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me

# Symmetric key used to encrypt the stored Garmin session at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Optional. Each user can pick a chatbot (Claude, ChatGPT, Gemini, Mistral)
# and paste their own API key in the app's Settings menu. This server-wide
# Anthropic key is only the fallback for users who haven't saved one.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used with the server-wide key above.
ANTHROPIC_MODEL=claude-opus-5-5

# How many days of Garmin history to pull on each sync.
GARMIN_SYNC_LOOKBACK_DAYS=30

# Comma-separated list of allowed CORS origins, or "*" for any (fine for a
# home-server deployment behind your own network/reverse proxy).
CORS_ALLOW_ORIGINS=*
