# Copy this file to .env and fill in real values before running
# `docker compose up` or deploying as a Portainer stack.

POSTGRES_USER=trainer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trainer

# Random secret used to sign JWT session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me

# Symmetric key used to encrypt the stored Garmin session at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# First admin account, created on the first start. ADMIN_PASSWORD is only used
# to create the account; change it later in the app (Settings). The admin
# creates everyone else's account in the app (Users button) - there is no sign-up.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# The built-in coach chat calls an AI provider's API (Claude, ChatGPT, ...).
# Off by default: plan and goals are edited on the page directly, by hand or
# with the Claude in Chrome extension. Set to true to bring the chat back.
AI_CHAT_ENABLED=false

# Only used when AI_CHAT_ENABLED=true. Each user can pick a chatbot and paste
# their own API key in Settings; this server-wide Anthropic key is the
# fallback for users who haven't saved one. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used with the server-wide key above.
ANTHROPIC_MODEL=claude-opus-5-5

# How many days of Garmin history to pull on each sync.
GARMIN_SYNC_LOOKBACK_DAYS=30

# Leave empty: the page is served by the app itself, so no other site needs
# to call the API. (Comma-separated origins, or "*", if you ever need it.)
CORS_ALLOW_ORIGINS=

# Swagger API docs at /docs. Keep false when friends reach the app from the internet.
ENABLE_API_DOCS=false
