# Copy this file to .env and fill in real values before running
# `docker compose up` or deploying as a Portainer stack.

POSTGRES_USER=trainer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trainer

# Random secret used to sign JWT session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me

# Symmetric key used to encrypt the stored Garmin session at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# First admin account, created on the first start. Required by the Docker /
# Portainer stack: put the admin username and password you want here (or in
# the stack's "Environment variables" section). ADMIN_PASSWORD needs at least
# 12 characters and is only used to create the account; change it later in the
# app (Settings). The admin can reset anyone's password, so don't reuse one
# from another site. This account is
# for managing the app only: it shows a dashboard (connections, accounts) and
# has no training calendar. Create your own personal account from it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# `npm start` also creates two generic accounts for local testing:
#   admin / adminadmin (admin)   and   user / useruser (regular user).
# Uncomment to turn that off. The Docker stack never creates them.
# SEED_TEST_ACCOUNTS=false

# How far back a sync looks. Only days that aren't stored yet are requested,
# so a larger value only makes the very first syncs longer.
GARMIN_SYNC_LOOKBACK_DAYS=90

# Hours between background syncs of every account connected to Garmin (sleep,
# readiness and finished sessions arrive without pressing Sync). The Docker
# stack uses 4 unless you set it; `npm start` leaves it off unless set here.
# 0 = off.
# AUTO_SYNC_HOURS=4

# Leave empty: the page is served by the app itself, so no other site needs
# to call the API. (Comma-separated origins, or "*", if you ever need it.)
CORS_ALLOW_ORIGINS=

# Swagger API docs at /docs. Keep false when friends reach the app from the internet.
ENABLE_API_DOCS=false

# --- Reaching the app from the internet -------------------------------------
# See "Letting friends reach it from outside your home" in the README.

# The public name friends open, without https:// (e.g. training.example.com).
# When set, the app only answers on https://<that name>: any other address,
# or plain http, is sent there. Leave empty on your own network.
APP_DOMAIN=

# Cloudflare Tunnel (optional): uncomment both lines to start the tunnel
# container. The token is shown by Cloudflare when you create the tunnel.
# COMPOSE_PROFILES=tunnel
# CLOUDFLARE_TUNNEL_TOKEN=
